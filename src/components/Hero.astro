---
import AppPreview from "./AppPreview.astro";
import { PLATFORMS, downloadUrl } from "../config";
import { formatSize, type Release } from "../lib/release";

interface Props {
  release: Release | null;
}

const { release } = Astro.props;
const [macos] = PLATFORMS;
const size = formatSize(release?.sizes[macos.asset]);

// Lo que señalan los números sobre la ventana de ejemplo.
const notes = [
  { title: "Push automático", body: "Cada edición vuelve al simulador o al emulador en cuanto se aplica." },
  { title: "Cambios desde la línea base", body: "Una fila insertada y otra modificada desde que fijaste la foto." },
  { title: "Live Watch", body: "Re-extrae la base de datos y repite la consulta cada 2 segundos." },
];
---

<section id="inicio" class="border-b border-border">
  <div class="mx-auto max-w-6xl px-4 pt-14 pb-16 sm:px-6 sm:pt-20">
    <div class="grid gap-8 lg:grid-cols-12 lg:items-end">
      <div class="min-w-0 lg:col-span-7">
        <p class="font-mono text-xs text-subtle">
          Inspector SQLite · Simulador de iOS · Emulador de Android
        </p>
        <h1
          class="mt-5 text-[2.5rem] leading-[1.05] font-semibold tracking-[-0.035em] text-balance sm:text-6xl"
        >
          Abre la base de datos de tu app móvil mientras la usas.
        </h1>
      </div>

      <div class="min-w-0 lg:col-span-5 lg:pb-1.5">
        <p class="text-pretty text-text-soft sm:text-lg">
          DB Bridge copia la SQLite del simulador o del emulador, te deja consultarla y editarla, y
          devuelve los cambios al dispositivo. Sin SDK que añadir a tu proyecto ni servidor que
          levantar.
        </p>

        <div class="mt-7 flex flex-wrap items-center gap-x-5 gap-y-3">
          <a
            id="primary-download"
            href={downloadUrl(macos.asset)}
            class="inline-flex items-center gap-2 rounded-md bg-text px-4 py-2.5 text-sm font-semibold text-bg hover:bg-white"
          >
            <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"
              aria-hidden="true"
              ><path d="M12 4v12m0 0-5-5m5 5 5-5M5 20h14" stroke-linecap="round" stroke-linejoin="round"
              ></path></svg
            >
            <span id="primary-download-label">Descargar para {macos.name}</span>
          </a>
          <a href="#descargar" class="text-sm text-muted underline-offset-4 hover:text-text hover:underline">
            Todas las plataformas
          </a>
        </div>
        <p class="mt-3 font-mono text-xs text-subtle">
          {release ? `v${release.version} · ` : ""}{size ? `${size} · ` : ""}macOS, Windows y Linux · Gratis
        </p>
      </div>
    </div>

    <div class="mt-14 sm:mt-16">
      <AppPreview />
      <ol class="mt-6 grid gap-4 text-sm sm:grid-cols-3 sm:gap-8">
        {
          notes.map((note, index) => (
            <li class="flex gap-3">
              <span class="grid size-5 shrink-0 place-items-center rounded-full border border-accent/60 font-mono text-[11px] text-accent">
                {index + 1}
              </span>
              <p class="text-muted">
                <span class="font-medium text-text">{note.title}.</span> {note.body}
              </p>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>

<script>
  import { PLATFORMS, downloadUrl, type PlatformId } from "../config";

  // El botón principal apunta a macOS sin JavaScript; aquí se ajusta al sistema del visitante.
  function detect(): PlatformId | null {
    const nav = navigator as Navigator & { userAgentData?: { platform?: string } };
    const platform = (nav.userAgentData?.platform || navigator.platform || "").toLowerCase();
    const agent = navigator.userAgent.toLowerCase();
    if (/iphone|ipad|android/.test(agent)) return null;
    if (platform.includes("win") || agent.includes("windows")) return "windows";
    if (platform.includes("linux") || agent.includes("linux")) return "linux";
    if (platform.includes("mac") || agent.includes("mac os")) return "macos";
    return null;
  }

  const id = detect();
  const platform = PLATFORMS.find((candidate) => candidate.id === id);
  const button = document.getElementById("primary-download") as HTMLAnchorElement | null;
  const label = document.getElementById("primary-download-label");
  if (button && label) {
    if (platform) {
      button.href = downloadUrl(platform.asset);
      label.textContent = `Descargar para ${platform.name}`;
    } else {
      // En móvil no hay nada que instalar: se lleva a la sección de descargas.
      button.href = "#descargar";
      label.textContent = "Ver descargas";
    }
  }
</script>

---
// Recreación en HTML de la ventana de la app (mismos colores y disposición), con datos de
// ejemplo. Es decorativa: el lector de pantalla recibe solo la descripción.
const tables = ["orders", "order_items", "products", "sync_outbox"];
const rows = [
  { id: 1041, status: "synced", total: "42.90", updated: "2026-11-10 09:14" },
  { id: 1042, status: "pending", total: "18.00", updated: "2026-11-10 09:21", changed: true },
  { id: 1043, status: "synced", total: "7.50", updated: "2026-11-10 09:30" },
  { id: 1044, status: null, total: "61.25", updated: "2026-11-10 09:42" },
  { id: 1045, status: "pending", total: "13.40", updated: "2026-11-10 09:55", added: true },
];
---

<figure
  class="overflow-hidden rounded-lg border border-border-strong bg-surface shadow-[0_30px_80px_-20px_rgba(0,0,0,0.6)]"
  aria-label="Ventana de DB Bridge mostrando la tabla orders de una app en el simulador de iOS"
>
  <div aria-hidden="true">
    <div class="flex items-center gap-2 border-b border-border px-4 py-2.5">
      <span class="size-3 rounded-full bg-[#ff5f57]"></span>
      <span class="size-3 rounded-full bg-[#febc2e]"></span>
      <span class="size-3 rounded-full bg-[#28c840]"></span>
      <span class="ml-3 hidden text-xs text-subtle sm:inline">DB Bridge · com.acme.shop/app.db</span>
      <span class="ml-auto flex items-center gap-2">
        <span class="grid size-4 place-items-center rounded-full bg-accent font-sans text-[10px] font-semibold text-on-accent">1</span>
        <span class="rounded-md border border-warning/40 px-2 py-0.5 text-[11px] text-warning">
          ↑ Push al simulador
        </span>
      </span>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-[170px_1fr]">
      <aside class="hidden border-r border-border bg-sidebar p-3 sm:block">
        <div class="rounded-lg border border-border bg-surface p-2.5">
          <p class="flex items-center gap-1.5 text-xs font-semibold">
            <span class="size-1.5 rounded-full bg-success"></span> Simulador iOS
          </p>
          <p class="mt-1 truncate font-mono text-[10px] text-muted">com.acme.shop/app.db</p>
          <p class="mt-2 flex items-center gap-1.5 text-[10px] text-muted">
            <span class="size-1.5 rounded-full bg-accent"></span> Línea base · hace 2 min
          </p>
        </div>
        <p class="mt-4 mb-1.5 text-[10px] font-semibold tracking-wider text-subtle uppercase">Tablas</p>
        <ul class="space-y-0.5 font-mono text-[11px]">
          {
            tables.map((table, index) => (
              <li
                class:list={[
                  "rounded-md px-2 py-1.5",
                  index === 0 ? "bg-raised text-text" : "text-text-soft",
                ]}
              >
                {table}
              </li>
            ))
          }
        </ul>
      </aside>

      <div class="min-w-0 p-3">
        <div class="rounded-lg border border-border bg-bg/60 px-3 py-2 font-mono text-[11px]">
          <span class="mr-2 text-faint">1</span><span class="text-keyword">SELECT</span>{" "}*{" "}<span
            class="text-keyword">FROM</span
          >{" "}<span class="text-ident">"orders"</span>{" "}<span class="text-keyword">WHERE</span
          >{" "}status ={" "}<span class="text-string">'pending'</span>{" "}<span
            class="text-keyword">LIMIT</span
          >{" "}<span class="text-number">200</span>
        </div>

        <div class="mt-3 overflow-hidden rounded-lg border border-border">
          <div class="flex items-center gap-2 border-b border-border px-3 py-2 text-[11px]">
            <span class="font-mono text-text">orders</span>
            <span class="text-muted">filas 1–5 de 1 284</span>
            <span class="rounded bg-success/15 px-1.5 text-success">Editable</span>
            <span class="ml-auto"><span class="grid size-4 place-items-center rounded-full bg-accent font-sans text-[10px] font-semibold text-on-accent">2</span></span>
            <span class="font-mono text-success">+1</span>
            <span class="font-mono text-warning">~1</span>
          </div>
          <div class="overflow-x-auto">
            <table class="w-full min-w-[420px] font-mono text-[11px]">
              <thead>
                <tr class="text-left text-muted">
                  <th class="px-3 py-1.5 font-sans font-semibold">id</th>
                  <th class="px-3 py-1.5 font-sans font-semibold text-accent">status ▲</th>
                  <th class="px-3 py-1.5 font-sans font-semibold">total</th>
                  <th class="px-3 py-1.5 font-sans font-semibold">updated_at</th>
                </tr>
              </thead>
              <tbody>
                {
                  rows.map((row, index) => (
                    <tr
                      class:list={[
                        index % 2 === 1 && "bg-hover/60",
                        row.added && "bg-success/10",
                      ]}
                    >
                      <td class="px-3 py-1.5 text-number">{row.id}</td>
                      <td class="px-3 py-1.5">
                        {row.status === null ? (
                          <span class="rounded bg-hover px-1 text-subtle italic">NULL</span>
                        ) : row.changed ? (
                          <span class="text-warning">synced → {row.status}</span>
                        ) : (
                          <span class="text-text">{row.status}</span>
                        )}
                      </td>
                      <td class="px-3 py-1.5 text-number">{row.total}</td>
                      <td class="px-3 py-1.5 text-text-soft">{row.updated}</td>
                    </tr>
                  ))
                }
              </tbody>
            </table>
          </div>
          <div class="flex items-center gap-2 border-t border-border px-3 py-2 text-[10px] text-muted">
            <span class="grid size-4 place-items-center rounded-full bg-accent font-sans text-[10px] font-semibold text-on-accent">3</span>
            Live Watch
            <span class="rounded-md bg-raised px-1.5 py-0.5 text-text">2 s</span>
            <span class="ml-auto">« ‹ Página 1 de 7 › »</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</figure>

---
// El mismo dibujo que public/favicon.svg, sin el fondo, para usarlo junto al nombre.
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<svg
  class={className}
  viewBox="0 0 24 24"
  fill="none"
  stroke="var(--color-accent)"
  stroke-width="2"
  aria-hidden="true"
>
  <ellipse cx="12" cy="6" rx="8" ry="3"></ellipse>
  <path d="M4 6v12c0 1.7 3.6 3 8 3s8-1.3 8-3V6M4 12c0 1.7 3.6 3 8 3s8-1.3 8-3"></path>
</svg>

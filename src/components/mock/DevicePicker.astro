---
import Panel from "./Panel.astro";

const columns = [
  {
    heading: "Dispositivo",
    items: [
      { name: "iPhone 16 Pro", meta: "iOS 18.2", dot: "bg-success", selected: true },
      { name: "Pixel 8", meta: "emulator-5554", dot: "bg-success" },
    ],
  },
  {
    heading: "App",
    items: [
      { name: "com.acme.shop", selected: true },
      { name: "com.acme.notes" },
      { name: "dev.gt2rz.habits" },
    ],
  },
  {
    heading: "Base de datos",
    items: [
      { name: "app.db", meta: "2,4 MB", selected: true },
      { name: "cache.sqlite", meta: "380 KB" },
    ],
  },
];
---

<Panel title="Conectar · Simulador de iOS" label="Selector de dispositivo, app y base de datos de DB Bridge">
  <div class="grid grid-cols-3 divide-x divide-border text-[12px]">
    {
      columns.map((column) => (
        <div class="min-w-0 p-3">
          <p class="mb-2 text-[10px] font-semibold tracking-wider text-subtle uppercase">{column.heading}</p>
          <ul class="space-y-0.5">
            {column.items.map((item) => (
              <li
                class:list={[
                  "rounded-md px-2 py-1.5",
                  item.selected ? "bg-raised text-text" : "text-text-soft",
                ]}
              >
                <span class="flex items-center gap-1.5 truncate font-mono">
                  {"dot" in item && <span class:list={["size-1.5 shrink-0 rounded-full", item.dot]} />}
                  {item.name}
                </span>
                {"meta" in item && <span class="mt-0.5 block truncate text-[10px] text-muted">{item.meta}</span>}
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>
  <div class="flex items-center gap-3 border-t border-border px-4 py-3 text-[11px]">
    <span class="truncate font-mono text-muted">…/Library/Application Support/app.db</span>
    <span class="ml-auto shrink-0 rounded-md bg-accent px-2.5 py-1 font-semibold text-on-accent">
      Extraer y conectar
    </span>
  </div>
</Panel>

---
import DevicePicker from "./mock/DevicePicker.astro";
import BaselineDiff from "./mock/BaselineDiff.astro";
import CellEdit from "./mock/CellEdit.astro";

// Las tres funciones principales, cada una con una maqueta de la parte de la app que describe.
const highlights = [
  {
    label: "Dispositivos",
    title: "Encuentra la base de datos sin buscar rutas.",
    body: "Pulsa Detectar y aparecen los simuladores y emuladores encendidos, sus apps (sin las del sistema) y las bases de datos de cada una. La copia incluye el WAL, así que ves lo último que escribió la app.",
    mock: DevicePicker,
  },
  {
    label: "Línea base",
    title: "Mira qué escribió tu app al pulsar un botón.",
    body: "Fija una foto de la base de datos, usa la app y abre Ver cambios: filas insertadas, eliminadas y modificadas celda a celda, además de tablas nuevas o con columnas distintas. Con Live Watch se actualiza sola.",
    mock: BaselineDiff,
  },
  {
    label: "Edición",
    title: "Cambia un dato y pruébalo en la app.",
    body: "Doble clic para editar, + Fila para insertar y clic derecho para poner a NULL o borrar. Con el push automático cada cambio vuelve al dispositivo en cuanto se aplica, también los INSERT, UPDATE o DDL del editor.",
    mock: CellEdit,
  },
];

const more = [
  ["Editor SQL", "Resaltado, números de línea y Cmd/Ctrl + Enter."],
  ["Scripts", "Varias sentencias dentro de un savepoint: si una falla, no se aplica ninguna."],
  ["Plan de consulta", "EXPLAIN QUERY PLAN de la consulta, en forma de árbol."],
  ["Historial y favoritas", "Las últimas 30 consultas, guardadas entre sesiones."],
  ["Esquema", "Columnas, índices, claves foráneas, triggers y el CREATE original."],
  ["Visor de valores", "JSON formateado y BLOB en hexadecimal con el tipo detectado."],
  ["Ordenar y filtrar", "Clic en la cabecera y búsqueda en todas las columnas."],
  ["Paginación", "Páginas de 200 filas con el total siempre a la vista."],
  ["Archivo local", "Arrastra un .db o .sqlite a la ventana y listo."],
];
---

<section id="funciones" class="border-b border-border">
  <div class="mx-auto max-w-6xl px-4 py-20 sm:px-6 sm:py-28">
    <div class="max-w-2xl">
      <h2 class="text-3xl font-semibold tracking-[-0.03em] sm:text-4xl">
        Hecho para depurar el estado local de una app.
      </h2>
      <p class="mt-4 text-muted">
        Flutter, React Native, Room, SQLDelight, SwiftData, Core Data: si tu app guarda su estado
        en SQLite, DB Bridge lo abre.
      </p>
    </div>

    <div class="mt-16 space-y-20 sm:space-y-28">
      {
        highlights.map((item, index) => (
          <article class="grid items-center gap-8 lg:grid-cols-12 lg:gap-12">
            <div class:list={["min-w-0 lg:col-span-5", index % 2 === 1 && "lg:order-2 lg:col-start-8"]}>
              <p class="font-mono text-xs text-accent">{item.label}</p>
              <h3 class="mt-3 text-2xl font-semibold tracking-[-0.02em] text-balance">{item.title}</h3>
              <p class="mt-4 leading-relaxed text-muted">{item.body}</p>
            </div>
            <div class:list={["min-w-0 lg:col-span-7", index % 2 === 1 && "lg:order-1 lg:col-start-1"]}>
              <item.mock />
            </div>
          </article>
        ))
      }
    </div>

    <div class="mt-24 border-t border-border pt-10">
      <h3 class="text-sm font-semibold text-text-soft">Y además</h3>
      <dl class="mt-6 grid gap-x-10 gap-y-6 text-sm sm:grid-cols-2 lg:grid-cols-3">
        {
          more.map(([term, description]) => (
            <div>
              <dt class="font-medium text-text">{term}</dt>
              <dd class="mt-1 text-muted">{description}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </div>
</section>

---
const features = [
  {
    title: "Simulador de iOS y emulador de Android",
    body: "Detecta los dispositivos encendidos, las apps instaladas y sus bases de datos. Extrae la copia con su WAL, sin tocar la app.",
    icon: "M7 3h10a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2Zm4 15h2",
  },
  {
    title: "Edita y envía al dispositivo",
    body: "Doble clic para editar, inserta o borra filas y pon valores a NULL. Con push automático, cada cambio vuelve a la app al momento.",
    icon: "M4 20h4l10-10-4-4L4 16v4Zm10-14 4 4",
  },
  {
    title: "Live Watch",
    body: "Vuelve a extraer y a ejecutar la consulta cada 2 s, 5 s, 30 s o 1 min para ver cómo escribe tu app en tiempo casi real.",
    icon: "M12 7v5l3 2M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z",
  },
  {
    title: "Qué cambió desde la línea base",
    body: "Fija una foto de la base de datos, usa la app y mira por tabla qué filas se insertaron, borraron o modificaron, celda a celda.",
    icon: "M8 7h12M8 12h12M8 17h12M4 7h.01M4 12h.01M4 17h.01",
  },
  {
    title: "Editor SQL completo",
    body: "Resaltado de sintaxis, scripts de varias sentencias en un savepoint, EXPLAIN QUERY PLAN, historial y consultas favoritas.",
    icon: "m8 9-3 3 3 3m8-6 3 3-3 3m-5 4 2-12",
  },
  {
    title: "Esquema y datos a la vista",
    body: "Columnas, índices, claves foráneas y triggers de cada tabla. Ordena, filtra y pagina miles de filas; JSON formateado y BLOB en hexadecimal.",
    icon: "M4 6c0-1.7 3.6-3 8-3s8 1.3 8 3-3.6 3-8 3-8-1.3-8-3Zm0 0v12c0 1.7 3.6 3 8 3s8-1.3 8-3V6M4 12c0 1.7 3.6 3 8 3s8-1.3 8-3",
  },
];
---

<section id="funciones" class="border-t border-border bg-sidebar/50">
  <div class="mx-auto max-w-6xl px-4 py-20 sm:px-6">
    <h2 class="text-3xl font-semibold tracking-tight sm:text-4xl">
      Todo lo que necesitas para depurar datos locales
    </h2>
    <p class="mt-3 max-w-2xl text-muted">
      Pensada para apps con Flutter, React Native, Room, SQLDelight, SwiftData o Core Data que
      guardan su estado en SQLite.
    </p>

    <ul class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        features.map((feature) => (
          <li class="rounded-xl border border-border bg-surface p-6">
            <span class="grid size-10 place-items-center rounded-lg bg-accent/12 text-accent">
              <svg
                class="size-5"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d={feature.icon} />
              </svg>
            </span>
            <h3 class="mt-4 font-semibold">{feature.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-muted">{feature.body}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

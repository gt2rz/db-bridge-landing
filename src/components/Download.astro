---
import { PLATFORMS, RELEASES_URL, downloadUrl } from "../config";
import { formatDate, formatSize, type Release } from "../lib/release";

interface Props {
  release: Release | null;
}

const { release } = Astro.props;
---

<section id="descargar" class="border-b border-border">
  <div class="mx-auto max-w-6xl px-4 py-20 sm:px-6 sm:py-28">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <div>
        <h2 class="text-3xl font-semibold tracking-[-0.03em] sm:text-4xl">Descargar</h2>
        <p class="mt-3 text-muted">
          {
            release
              ? `Versión ${release.version}, publicada el ${formatDate(release.publishedAt)}.`
              : "Última versión publicada."
          }
        </p>
      </div>
      <a href={release?.url ?? RELEASES_URL} class="text-sm text-muted underline-offset-4 hover:text-text hover:underline">
        Notas de la versión y versiones anteriores ↗
      </a>
    </div>

    <ul class="mt-10 divide-y divide-border border-y border-border">
      {
        PLATFORMS.map((platform) => {
          const size = formatSize(release?.sizes[platform.asset]);
          return (
            <li>
              <div class="flex flex-wrap items-center gap-x-6 gap-y-3 py-6">
                <div class="min-w-48 flex-1">
                  <h3 class="text-lg font-semibold">{platform.name}</h3>
                  <p class="mt-0.5 text-sm text-muted">{platform.detail}</p>
                </div>
                <p class="w-full font-mono text-xs text-subtle sm:w-auto">
                  {platform.asset}
                  {size && ` · ${size}`}
                  {" · "}
                  <a href={downloadUrl(`${platform.asset}.sha256`)} class="underline-offset-4 hover:text-text hover:underline">
                    SHA-256
                  </a>
                </p>
                <a
                  href={downloadUrl(platform.asset)}
                  class="inline-flex items-center gap-2 rounded-md border border-border-strong bg-surface px-4 py-2 text-sm font-semibold hover:border-text/40 hover:bg-raised"
                >
                  Descargar
                </a>
              </div>

              <details class="group pb-6">
                <summary class="flex w-fit cursor-pointer list-none items-center gap-1.5 text-sm text-muted hover:text-text [&::-webkit-details-marker]:hidden">
                  <span class="inline-block transition-transform group-open:rotate-90">›</span>
                  Instalación y requisitos
                </summary>
                <div class="mt-4 grid gap-6 pl-4 text-sm sm:grid-cols-2">
                  <div>
                    <h4 class="font-medium text-text-soft">Primera vez</h4>
                    <ol class="mt-2 list-decimal space-y-1.5 pl-5 text-muted marker:font-mono marker:text-xs marker:text-subtle">
                      {platform.firstRun.map((step) => (
                        <li class="break-words">{step}</li>
                      ))}
                    </ol>
                  </div>
                  <div>
                    <h4 class="font-medium text-text-soft">Necesitas</h4>
                    <ul class="mt-2 space-y-1.5 text-muted">
                      {platform.needs.map((need) => (
                        <li>{need}</li>
                      ))}
                    </ul>
                  </div>
                </div>
              </details>
            </li>
          );
        })
      }
    </ul>

    <div class="mt-8 max-w-3xl border-l-2 border-warning/60 pl-4 text-sm">
      <p class="font-medium text-text-soft">En Android, la app debe estar compilada en modo debug.</p>
      <p class="mt-1 text-muted">
        DB Bridge lee el contenedor de la app con <code class="font-mono text-text-soft">run-as</code>,
        que solo funciona con APK depurables. En iOS basta con el simulador encendido (Xcode solo
        existe en macOS).
      </p>
    </div>
  </div>
</section>

---
import { PLATFORMS, RELEASES_URL, downloadUrl } from "../config";
import { formatDate, formatSize, type Release } from "../lib/release";

interface Props {
  release: Release | null;
}

const { release } = Astro.props;
---

<section id="descargar" class="border-t border-border bg-sidebar/50">
  <div class="mx-auto max-w-6xl px-4 py-20 sm:px-6">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <div>
        <h2 class="text-3xl font-semibold tracking-tight sm:text-4xl">Descargar</h2>
        <p class="mt-3 text-muted">
          {
            release
              ? `Versión ${release.version}, publicada el ${formatDate(release.publishedAt)}.`
              : "Última versión publicada."
          }
        </p>
      </div>
      <a href={release?.url ?? RELEASES_URL} class="text-sm text-accent hover:underline">
        Notas de la versión y versiones anteriores →
      </a>
    </div>

    <div class="mt-10 grid gap-4 lg:grid-cols-3">
      {
        PLATFORMS.map((platform) => {
          const size = formatSize(release?.sizes[platform.asset]);
          return (
            <article class="flex flex-col rounded-xl border border-border bg-surface p-6">
              <h3 class="text-xl font-semibold">{platform.name}</h3>
              <p class="mt-1 text-sm text-muted">{platform.detail}</p>

              <a
                href={downloadUrl(platform.asset)}
                class="mt-5 inline-flex items-center justify-center gap-2 rounded-lg bg-accent px-4 py-2.5 font-semibold text-on-accent hover:brightness-110"
              >
                Descargar
                {size && <span class="font-normal opacity-75">· {size}</span>}
              </a>
              <p class="mt-2 truncate text-center font-mono text-xs text-subtle">
                {platform.asset}
                {" · "}
                <a href={downloadUrl(`${platform.asset}.sha256`)} class="hover:text-text">
                  SHA-256
                </a>
              </p>

              <h4 class="mt-6 text-sm font-semibold text-text-soft">Primera vez</h4>
              <ol class="mt-2 list-decimal space-y-1.5 pl-5 text-sm text-muted marker:text-subtle">
                {platform.firstRun.map((step) => (
                  <li class="break-words">{step}</li>
                ))}
              </ol>

              <h4 class="mt-6 text-sm font-semibold text-text-soft">Necesitas</h4>
              <ul class="mt-2 space-y-1.5 text-sm text-muted">
                {platform.needs.map((need) => (
                  <li class="flex gap-2">
                    <span class="mt-2 size-1 shrink-0 rounded-full bg-subtle" />
                    {need}
                  </li>
                ))}
              </ul>
            </article>
          );
        })
      }
    </div>

    <div class="mt-8 rounded-xl border border-warning/30 bg-warning/5 p-5 text-sm text-text-soft">
      <p class="font-semibold text-warning">Android: la app debe estar compilada en modo debug</p>
      <p class="mt-1 text-muted">
        DB Bridge lee el contenedor de la app con <code class="font-mono text-text">run-as</code>,
        que solo funciona con APK depurables. En iOS basta con el simulador encendido (Xcode solo
        existe en macOS).
      </p>
    </div>
  </div>
</section>
